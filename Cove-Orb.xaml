<ControlTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TargetType="Button">
 <Grid RenderTransformOrigin="0.5,0.5" Background="Transparent">
  <Grid.RenderTransform><ScaleTransform x:Name="HoverScale"/></Grid.RenderTransform>
  <Ellipse x:Name="Echo" Margin="6" Stroke="#749CE9EB" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
   <Ellipse.RenderTransform><ScaleTransform x:Name="EchoScale"/></Ellipse.RenderTransform>
  </Ellipse>
  <Grid Margin="7" RenderTransformOrigin="0.5,0.5">
   <Grid.RenderTransform><ScaleTransform x:Name="Breath"/></Grid.RenderTransform>
   <Ellipse Fill="#101A35"/>
   <Ellipse Opacity="0.8" Fill="{TemplateBinding Background}"/>
   <Grid Width="94" Height="94" IsHitTestVisible="False">
    <Grid.Clip><EllipseGeometry Center="47,47" RadiusX="46" RadiusY="46"/></Grid.Clip>
    <Grid x:Name="Liquid" RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><RotateTransform x:Name="LiquidTurn"/></Grid.RenderTransform>
     <Ellipse Width="126" Height="104" Margin="-34,-22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Ellipse.Fill><RadialGradientBrush GradientOrigin="0.45,0.45"><GradientStop Color="{DynamicResource CovePrimaryCloud}"/><GradientStop Color="{DynamicResource CovePrimaryMist}" Offset="0.5"/><GradientStop Color="{DynamicResource CovePrimaryClear}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
     <Ellipse Width="110" Height="120" Margin="0,12,-30,-24" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource CoveSecondaryCloud}"/><GradientStop Color="{DynamicResource CoveSecondaryMist}" Offset="0.48"/><GradientStop Color="{DynamicResource CoveSecondaryClear}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
     <Ellipse x:Name="Pearl" Width="64" Height="72" Margin="8,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><TranslateTransform x:Name="Drift"/></Ellipse.RenderTransform>
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource CoveLightCloud}"/><GradientStop Color="{DynamicResource CovePrimaryMist}" Offset="0.42"/><GradientStop Color="{DynamicResource CovePrimaryClear}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
    </Grid>
    <Ellipse x:Name="VoiceLight" Opacity="0" Margin="12">
     <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource CoveLightCloud}"/><GradientStop Color="{DynamicResource CovePrimaryMist}" Offset="0.4"/><GradientStop Color="{DynamicResource CovePrimaryClear}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>
    <Ellipse>
     <Ellipse.Fill><RadialGradientBrush Center="0.43,0.37" GradientOrigin="0.35,0.26" RadiusX="0.68" RadiusY="0.68"><GradientStop Color="#00FFFFFF" Offset="0.25"/><GradientStop Color="#08081732" Offset="0.6"/><GradientStop Color="#AF080F29" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="64" Height="44" Margin="7,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.5">
     <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource CoveLightCloud}"/><GradientStop Color="{DynamicResource CovePrimaryClear}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>
   </Grid>
   <Grid Width="38" Height="38" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
    <Ellipse Fill="#180C1730"/>
    <Path Data="M 27,10 A 12,12 0 1 0 27,28" Stroke="#F2EEFFF9" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Path.Effect><DropShadowEffect Color="{DynamicResource CovePrimary}" BlurRadius="7" ShadowDepth="0" Opacity="0.45"/></Path.Effect>
    </Path>
    <Ellipse Width="4" Height="4" Fill="#E6FFF7" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center"/>
   </Grid>
   <Ellipse StrokeThickness="0.8" Margin="0.5">
    <Ellipse.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource CoveRim}"/><GradientStop Color="{DynamicResource CovePrimaryMist}" Offset="0.5"/><GradientStop Color="{DynamicResource CoveSecondaryMist}" Offset="1"/></LinearGradientBrush></Ellipse.Stroke>
   </Ellipse>
  </Grid>
 </Grid>
 <ControlTemplate.Triggers>
  <EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard>
   <DoubleAnimation Storyboard.TargetName="Breath" Storyboard.TargetProperty="ScaleX" From="0.96" To="1" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
   <DoubleAnimation Storyboard.TargetName="Breath" Storyboard.TargetProperty="ScaleY" From="0.96" To="1" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
   <DoubleAnimation Storyboard.TargetName="LiquidTurn" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:24" RepeatBehavior="Forever"/>
   <DoubleAnimation Storyboard.TargetName="Drift" Storyboard.TargetProperty="X" From="-9" To="16" Duration="0:0:4.7" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
   <DoubleAnimation Storyboard.TargetName="Drift" Storyboard.TargetProperty="Y" From="-3" To="19" Duration="0:0:6.1" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
  </Storyboard></BeginStoryboard></EventTrigger>
  <Trigger Property="Tag" Value="Listening">
   <Trigger.EnterActions><BeginStoryboard x:Name="ListenPulse"><Storyboard>
    <DoubleAnimation Storyboard.TargetName="EchoScale" Storyboard.TargetProperty="ScaleX" From="0.94" To="1.16" Duration="0:0:1.8" RepeatBehavior="Forever"/>
    <DoubleAnimation Storyboard.TargetName="EchoScale" Storyboard.TargetProperty="ScaleY" From="0.94" To="1.16" Duration="0:0:1.8" RepeatBehavior="Forever"/>
    <DoubleAnimation Storyboard.TargetName="Echo" Storyboard.TargetProperty="Opacity" From="0.65" To="0" Duration="0:0:1.8" RepeatBehavior="Forever"/>
   </Storyboard></BeginStoryboard></Trigger.EnterActions>
   <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="ListenPulse"/></Trigger.ExitActions>
  </Trigger>
  <Trigger Property="Tag" Value="Thinking">
   <Trigger.EnterActions><BeginStoryboard x:Name="ThinkFlow" HandoffBehavior="Compose"><Storyboard>
    <DoubleAnimation Storyboard.TargetName="LiquidTurn" Storyboard.TargetProperty="Angle" By="360" Duration="0:0:4" RepeatBehavior="Forever"/>
    <DoubleAnimation Storyboard.TargetName="VoiceLight" Storyboard.TargetProperty="Opacity" From="0.05" To="0.35" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"/>
   </Storyboard></BeginStoryboard></Trigger.EnterActions>
   <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="ThinkFlow"/></Trigger.ExitActions>
  </Trigger>
  <Trigger Property="Tag" Value="Speaking">
   <Trigger.EnterActions><BeginStoryboard x:Name="SpeakPulse" HandoffBehavior="Compose"><Storyboard>
    <DoubleAnimation Storyboard.TargetName="VoiceLight" Storyboard.TargetProperty="Opacity" From="0.1" To="0.8" Duration="0:0:0.62" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
    <DoubleAnimation Storyboard.TargetName="Breath" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.035" Duration="0:0:0.62" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
    <DoubleAnimation Storyboard.TargetName="Breath" Storyboard.TargetProperty="ScaleY" From="0.97" To="1.025" Duration="0:0:0.81" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
   </Storyboard></BeginStoryboard></Trigger.EnterActions>
   <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="SpeakPulse"/></Trigger.ExitActions>
  </Trigger>
  <Trigger Property="Tag" Value="Paused"><Setter TargetName="Liquid" Property="Opacity" Value="0.28"/><Setter TargetName="Pearl" Property="Opacity" Value="0.2"/></Trigger>
  <Trigger Property="IsMouseOver" Value="True">
   <Trigger.EnterActions><BeginStoryboard><Storyboard>
    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.045" Duration="0:0:0.2"/>
    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.045" Duration="0:0:0.2"/>
   </Storyboard></BeginStoryboard></Trigger.EnterActions>
   <Trigger.ExitActions><BeginStoryboard><Storyboard>
    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
   </Storyboard></BeginStoryboard></Trigger.ExitActions>
  </Trigger>
  <Trigger Property="IsPressed" Value="True"><Setter TargetName="Liquid" Property="Opacity" Value="0.6"/></Trigger>
 </ControlTemplate.Triggers>
</ControlTemplate>
